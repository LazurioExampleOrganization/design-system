  "font": {
    "text": "text",
    "heading": "heading",
    "mono": "mono"
  },
  "type": {
    "hero": {
      "font": "heading",
      "size": "56px",
      "leading": "1.02",
      "weight": "600",
      "tracking": "-0.02em"
    },
    "section": {
      "font": "heading",
      "size": "clamp(32px, 3.4vw, 44px)",
      "leading": "1.12",
      "weight": "600",
      "tracking": "-0.016em"
    },
    "display": {
      "font": "heading",
      "size": "34px",
      "leading": "1.12",
      "weight": "600",
      "tracking": "-0.016em"
    },
    "title": {
      "font": "heading",
      "size": "20px",
      "leading": "1.3",
      "weight": "600",
      "tracking": "-0.015em"
    },
    "lead": {
      "font": "text",
      "size": "20px",
      "leading": "1.55",
      "weight": "400",
      "tracking": "-0.011em"
    },
    "body": {
      "font": "text",
      "size": "16.5px",
      "leading": "1.6",
      "weight": "400",
      "tracking": "-0.011em"
    },
    "body-sm": {
      "font": "text",
      "size": "15px",
      "leading": "1.5",
