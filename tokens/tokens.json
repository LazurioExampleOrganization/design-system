{
  "schema": "design-system.tokens.v1",
  "prefix": "ds",
  "color": {
    "bg": {
      "light": "neutral.25",
      "dark": "neutral.950",
      "use": {
        "cs": "Stránka za všemi plochami.",
        "en": "The page behind every surface."
      }
    },
    "surface": {
      "light": "neutral.0",
      "dark": "neutral.900",
      "use": {
        "cs": "Dokumenty, karty, tabulky a pole.",
        "en": "Documents, cards, tables and fields."
      }
    },
    "surface-muted": {
      "light": "neutral.50",
      "dark": "neutral.800",
      "use": {
        "cs": "Tiché výplně: měkké tlačítko, hlavička tabulky, kód.",
        "en": "Quiet fills: the soft button, a table head, code."
      }
    },
    "surface-hover": {
      "light": "neutral.50",
      "dark": "neutral.800",
      "use": {
        "cs": "Řádek nebo položka pod ukazatelem.",
        "en": "A row or item under the pointer."
      }
    },
    "surface-selected": {
      "light": "neutral.100",
      "dark": "neutral.700",
      "use": {
        "cs": "Vybraná položka: o stupeň tmavší, nikdy barva.",
        "en": "The selected item: one step darker, never colour."
      }
    },
    "surface-raised": {
      "light": "neutral.0",
      "dark": "neutral.800",
      "use": {
        "cs": "Plovoucí vrstva: nabídky, dialogy, oznámení.",
        "en": "The floating layer: menus, dialogs, toasts."
      }
    },
    "ink": {
      "light": "neutral.950",
      "dark": "neutral.25",
      "use": {
        "cs": "Text a ikony.",
        "en": "Text and icons."
      }
    },
    "ink-muted": {
      "light": "neutral.500",
      "dark": "neutral.400",
      "use": {
        "cs": "Doplňkový text: nápovědy, metadata, popisky.",
        "en": "Secondary text: hints, meta, captions."
      }
    },
    "ink-faint": {
      "light": "neutral.400",
      "dark": "neutral.600",
      "use": {
        "cs": "Nikdy text, který se má číst: tahy, oddělovače, ilustrace.",
        "en": "Never text people must read: strokes, separators, illustrations."
      }
    },
    "line": {
      "light": "neutral.200",
      "dark": "neutral.700",
      "use": {
        "cs": "Vlasové linky mezi plochami a kolem karet.",
        "en": "Hairlines between areas and around cards."
      }
    },
    "line-strong": {
      "light": "neutral.400",
      "dark": "neutral.500",
      "use": {
        "cs": "Hranice polí a ovládacích prvků; aspoň 3 : 1.",
        "en": "The boundary of fields and controls; at least 3:1."
      }
    },
    "accent": {
      "light": "accent.500",
      "dark": "accent.300",
      "use": {
        "cs": "Odkazy, aktivní stav, jedno slovo nadpisu. Střídmě.",
        "en": "Links, the active state, one word of a heading. Sparingly."
      }
    },
    "accent-strong": {
      "light": "accent.600",
      "dark": "accent.200",
      "use": {
        "cs": "Akcent pod ukazatelem a v drobném textu.",
        "en": "The accent under the pointer and in small text."
      }
    },
    "accent-soft": {
      "light": "accent.50",
      "dark": "accent.950",
      "use": {
        "cs": "Tichý akcentní podklad.",
        "en": "A quiet accent background."
      }
    },
    "on-accent": {
      "light": "neutral.0",
      "dark": "neutral.950",
      "use": {
        "cs": "Text a ikony na akcentu.",
        "en": "Text and icons on the accent."
      }
    },
    "action": {
      "light": "neutral.950",
      "dark": "neutral.25",
      "use": {
        "cs": "Hlavní tlačítko: černé ve světlém, bílé v tmavém režimu.",
        "en": "The primary button: black in light, white in dark."
      }
    },
    "action-hover": {
      "light": "neutral.800",
      "dark": "neutral.200",
      "use": {
        "cs": "Hlavní tlačítko pod ukazatelem.",
        "en": "The primary button under the pointer."
      }
    },
    "on-action": {
      "light": "neutral.0",
      "dark": "neutral.950",
      "use": {
        "cs": "Text a ikony na hlavním tlačítku.",
        "en": "Text and icons on the primary button."
      }
    },
    "focus": {
      "light": "neutral.950",
      "dark": "neutral.25",
      "use": {
        "cs": "Rámeček fokusu: neutrální inkoust, nikdy barevná záře.",
        "en": "The focus ring: neutral ink, never a coloured glow."
      }
    },
    "danger": {
      "light": "red.600",
      "dark": "red.300",
      "use": {
        "cs": "Text a ikona chyby.",
        "en": "Text and icon of an error."
      }
    },
    "danger-soft": {
      "light": "red.50",
      "dark": "red.950",
      "use": {
        "cs": "Podklad hlášení chyby.",
        "en": "Background of an error notice."
      }
    },
    "danger-line": {
      "light": "red.200",
      "dark": "red.800",
      "use": {
        "cs": "Okraj hlášení chyby nebo chybného pole.",
        "en": "Border of an error notice or field."
      }
    },
    "danger-solid": {
      "light": "red.600",
      "dark": "red.300",
      "use": {
        "cs": "Tlačítko nevratné akce.",
        "en": "The destructive button."
      }
    },
    "on-danger": {
      "light": "neutral.0",
      "dark": "neutral.950",
      "use": {
        "cs": "Text na tlačítku nevratné akce.",
        "en": "Text on the destructive button."
      }
    },
    "warning": {
      "light": "amber.600",
      "dark": "amber.300",
      "use": {
        "cs": "Text a ikona varování.",
        "en": "Text and icon of a warning."
      }
    },
    "warning-soft": {
      "light": "amber.50",
      "dark": "amber.950",
      "use": {
        "cs": "Podklad varování.",
        "en": "Background of a warning."
      }
    },
    "warning-line": {
      "light": "amber.200",
      "dark": "amber.800",
      "use": {
        "cs": "Okraj varování.",
        "en": "Border of a warning."
      }
    },
    "success": {
      "light": "green.600",
      "dark": "green.300",
      "use": {
        "cs": "Text a ikona úspěchu.",
        "en": "Text and icon of a success."
      }
    },
    "success-soft": {
      "light": "green.50",
      "dark": "green.950",
      "use": {
        "cs": "Podklad úspěchu.",
        "en": "Background of a success."
      }
    },
    "success-line": {
      "light": "green.200",
      "dark": "green.800",
      "use": {
        "cs": "Okraj úspěchu.",
        "en": "Border of a success."
      }
    },
    "info": {
      "light": "accent.600",
      "dark": "accent.200",
      "use": {
        "cs": "Text a ikona informace.",
        "en": "Text and icon of information."
      }
    },
    "info-soft": {
      "light": "accent.50",
      "dark": "accent.950",
      "use": {
        "cs": "Podklad informace.",
        "en": "Background of information."
      }
    },
    "info-line": {
      "light": "accent.200",
      "dark": "accent.800",
      "use": {
        "cs": "Okraj informace.",
        "en": "Border of information."
      }
    }
  },
  "contrast": {
