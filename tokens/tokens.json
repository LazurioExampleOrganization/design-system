      "tracking": "-0.011em"
    },
    "status": {
      "font": "text",
      "size": "13.5px",
      "leading": "1.4",
      "weight": "600",
      "tracking": "-0.006em"
    },
    "mono": {
      "font": "mono",
      "size": "14px",
      "leading": "1.5",
      "weight": "400",
      "tracking": "0"
