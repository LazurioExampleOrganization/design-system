    "icon-md": "20px",
    "icon-lg": "24px",
    "border": "1px",
    "focus-width": "2px",
    "focus-offset": "2px",
    "measure": "68ch",
    "sidebar": "264px",
    "container": "1200px",
    "indicator": "2px",
    "dialog-sm": "420px",
    "dialog-md": "560px",
    "dialog-lg": "720px",
    "toast": "380px"
  },
  "z": {
    "sticky": "10",
    "dropdown": "20",
    "dialog": "40",
    "toast": "50"
  },
  "breakpoint": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px"
  }
}
