    "128": "128px"
  },
  "shadow": {
    "float": {
      "light": "0 8px 24px rgba(9, 9, 9, 0.1)",
      "dark": "0 8px 24px rgba(0, 0, 0, 0.45)",
      "use": {
        "cs": "Jen plovoucí vrstva, vždy s vlasovou linkou.",
        "en": "Only the floating layer, always with a line."
      }
    },
    "overlay": {
      "light": "rgba(9, 9, 9, 0.32)",
      "dark": "rgba(0, 0, 0, 0.6)",
      "use": {
        "cs": "Závoj za dialogem.",
        "en": "The backdrop behind a dialog."
      }
    }
  },
  "motion": {
    "duration": {
      "press": "120ms",
      "fast": "160ms",
      "base": "200ms",
      "slow": "280ms",
      "exit": "140ms"
    },
    "ease": {
      "out": "cubic-bezier(0.23, 1, 0.32, 1)",
      "in-out": "cubic-bezier(0.77, 0, 0.175, 1)",
      "standard": "ease",
      "linear": "linear"
    }
  },
  "size": {
