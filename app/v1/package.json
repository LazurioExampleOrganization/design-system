{
  "name": "design-system-app-v1",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "prepare:app": "astro sync",
    "check:prepared": "bun run src/prepared.ts",
    "typecheck": "astro check",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "astro check && biome check .",
    "test": "bun test"
  },
  "dependencies": {
    "@lazurio/module-kit": "github:Lazurio/module-kit#v0.2.0",
    "astro": "5.18.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@biomejs/biome": "2.4.15",
    "@types/bun": "1.4.2",
    "typescript": "5.9.3"
  },
  "lazurio": {
    "runtime": {
      "schema_version": "lazurio.runtime.v1",
      "id": "lazurioexampleorganization-design-system-v1",
      "title": "Design system",
      "company": "LazurioExampleOrganization",
      "module": "design-system",
      "surface": "internal",
      "dev_script": "dev",
      "build_script": "build",
      "build_output": "dist",
      "static_fallback": "404",
      "tags": [
        "design-system",
        "brand"
      ],
      "listeners": [
        {
          "id": "app",
          "role": "entrypoint",
          "lease": "main",
          "protocol": "http",
          "health": {
            "kind": "http",
            "path": "/"
          }
        }
      ]
    },
    "preparation": {
      "schema_version": "lazurio.preparation.v1",
      "owner_package": "app/v1/package.json",
      "prepare_script": "prepare:app",
      "check_script": "check:prepared"
    }
  }
}
