{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "**",
      "!dist",
      "!.astro",
      "!**/*.astro",
      "!kit/tokens.ts",
      "!kit/tokens.css",
      "!kit/fonts.css",
      "!kit/brand.ts",
      "!kit/core/icons.ts",
      "!kit/manifest.json",
      "!public"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended", "suspicious": { "noExplicitAny": "error" } }
  },
  "markdown": { "formatter": { "enabled": false } },
  "yaml": { "formatter": { "enabled": false } },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
