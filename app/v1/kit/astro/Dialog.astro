---
import { cx } from "../core/classes";
import { messagesFor } from "../core/i18n";
import type { Locale } from "../core/types";
import Icon from "./Icon.astro";

interface Props {
  id: string;
  title: string;
  description?: string;
  size?: "sm" | "md" | "lg";
  /** A click on the backdrop closes it. Never for a dialog with unsaved input. */
  dismissable?: boolean;
  locale?: Locale;
}

const { id, title, description, size = "md", dismissable, locale } = Astro.props;
---
<dialog
  class={cx("ds-dialog", size !== "md" && `ds-dialog--${size}`)}
  id={id}
  aria-labelledby={`${id}-title`}
  aria-describedby={description ? `${id}-description` : undefined}
  data-ds-dismissable={dismissable ? "" : undefined}
>
  <header class="ds-dialog__header">
    <h2 class="ds-dialog__title" id={`${id}-title`}>{title}</h2>
    <form method="dialog">
      <button
        type="submit"
        value="cancel"
        class="ds-button ds-button--quiet ds-button--sm ds-button--icon ds-dialog__close"
        aria-label={messagesFor(locale).close}
      >
        <Icon name="xmark" />
      </button>
    </form>
  </header>
  {description && <p class="ds-dialog__description" id={`${id}-description`}>{description}</p>}
  <div class="ds-dialog__body"><slot /></div>
  {Astro.slots.has("footer") && <footer class="ds-dialog__footer"><slot name="footer" /></footer>}
</dialog>

<script>
  import { bindDialogs } from "../core/dialog";

  bindDialogs();
</script>
