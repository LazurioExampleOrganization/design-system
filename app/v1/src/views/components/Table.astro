---
import Badge from "@design-system/astro/Badge.astro";
import EmptyState from "@design-system/astro/EmptyState.astro";
import Icon from "@design-system/astro/Icon.astro";
import Table from "@design-system/astro/Table.astro";
import Demo from "../../components/Demo.astro";
import States from "../../components/States.astro";
import { date, INVOICES, money, STATE } from "../../lib/sample";
import type { ViewProps } from "../types";
import Layout from "./Layout.astro";

type Props = ViewProps;
const props = Astro.props;
const { locale } = props;
const t = {
  cs: {
    caption: "Faktury za listopad",
    number: "Číslo",
    customer: "Zákazník",
    due: "Splatnost",
    state: "Stav",
    amount: "Částka",
    sorted: "seřazeno vzestupně",
    states: ["Kompaktní", "Vybraný řádek", "Prázdná"],
    empty: "Zatím žádné faktury",
    emptyText: "Až vystavíte první fakturu, objeví se tady.",
  },
  en: {
    caption: "Invoices for November",
    number: "Number",
    customer: "Customer",
    due: "Due",
    state: "Status",
    amount: "Amount",
    sorted: "sorted ascending",
    states: ["Compact", "A selected row", "Empty"],
    empty: "No invoices yet",
    emptyText: "Once you issue the first invoice, it appears here.",
  },
}[locale];
const rows = INVOICES.slice(0, 4);
const code = {
  astro: `
---
import Table from "@design-system/astro/Table.astro";
import Badge from "@design-system/astro/Badge.astro";
---
<Table id="invoices" caption="${t.caption}">
  <thead>
    <tr><th scope="col">${t.customer}</th><th scope="col">${t.state}</th><th scope="col" class="ds-table__num">${t.amount}</th></tr>
  </thead>
  <tbody>
    {invoices.map((invoice) => (
      <tr>
        <td>{invoice.customer}</td>
        <td><Badge tone={invoice.tone}>{invoice.state}</Badge></td>
        <td class="ds-table__num">{invoice.amount}</td>
      </tr>
    ))}
  </tbody>
</Table>`,
  react: `
import { Badge, Table } from "@design-system/react";

<Table id="invoices" caption="${t.caption}">
  <thead>
    <tr><th scope="col">${t.customer}</th><th scope="col">${t.state}</th><th scope="col" className="ds-table__num">${t.amount}</th></tr>
  </thead>
  <tbody>
    {invoices.map((invoice) => (
      <tr key={invoice.number}>
        <td>{invoice.customer}</td>
        <td><Badge tone={invoice.tone}>{invoice.state}</Badge></td>
        <td className="ds-table__num">{invoice.amount}</td>
      </tr>
    ))}
  </tbody>
</Table>`,
};
---
<Layout {...props} code={code}>
  <Demo slot="example" locale={locale} single>
    {
      () => (
        <Table id="invoices-example" caption={t.caption} interactive>
          <thead>
            <tr>
              <th scope="col">{t.number}</th>
              <th scope="col">{t.customer}</th>
              <th scope="col" aria-sort="ascending">
                <button type="button" class="ds-table__sort">
                  {t.due}
                  <Icon name="sort-up" size="sm" />
                  <span class="ds-visually-hidden">, {t.sorted}</span>
                </button>
              </th>
              <th scope="col">{t.state}</th>
              <th scope="col" class="ds-table__num">{t.amount}</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((invoice) => (
              <tr>
                <td class="ds-table__nowrap"><code>{invoice.number}</code></td>
                <td>{invoice.customer}</td>
                <td class="ds-table__nowrap">{date(invoice.due, locale)}</td>
                <td><Badge tone={STATE[invoice.state].tone}>{STATE[invoice.state].label[locale]}</Badge></td>
                <td class="ds-table__num">{money(invoice.amount, locale)}</td>
              </tr>
            ))}
          </tbody>
        </Table>
      )
    }
  </Demo>
  <States slot="states" items={t.states} wide>
    {
      (index: number) =>
        [
          <Table id="invoices-compact" caption={t.caption} hideCaption density="compact">
            <thead><tr><th scope="col">{t.customer}</th><th scope="col" class="ds-table__num">{t.amount}</th></tr></thead>
            <tbody>{rows.slice(0, 3).map((invoice) => <tr><td>{invoice.customer}</td><td class="ds-table__num">{money(invoice.amount, locale)}</td></tr>)}</tbody>
          </Table>,
          <Table id="invoices-selected" caption={t.caption} hideCaption>
            <thead><tr><th scope="col">{t.customer}</th><th scope="col" class="ds-table__num">{t.amount}</th></tr></thead>
            <tbody>{rows.slice(0, 3).map((invoice, i) => <tr class={i === 1 ? "ds-table__row--selected" : undefined}><td>{invoice.customer}</td><td class="ds-table__num">{money(invoice.amount, locale)}</td></tr>)}</tbody>
          </Table>,
          <div class="ds-table-wrap">
            <EmptyState title={t.empty} icon="page" headingLevel={3}><p>{t.emptyText}</p></EmptyState>
          </div>,
        ][index]
    }
  </States>
</Layout>
