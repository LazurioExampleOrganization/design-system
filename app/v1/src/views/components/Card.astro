---
import Badge from "@design-system/astro/Badge.astro";
import Button from "@design-system/astro/Button.astro";
import Card from "@design-system/astro/Card.astro";
import Demo from "../../components/Demo.astro";
import States from "../../components/States.astro";
import type { ViewProps } from "../types";
import Layout from "./Layout.astro";

type Props = ViewProps;
const props = Astro.props;
const { locale } = props;
const t = {
  cs: {
    title: "Nabídka pro Studio Lípa",
    description: "Webové stránky a správa na rok",
    body: "Platnost do 30. listopadu. Zákazník ji zatím neotevřel.",
    open: "Otevřít",
    send: "Připomenout",
    sent: "Odesláno",
    muted: "Tip",
    mutedText: "Šablonu nabídky upravíte v Nastavení.",
    link: "Ceník služeb",
    linkText: "Ceny, ze kterých se skládají nabídky.",
    states: ["S obsahem a akcemi", "Tlumená", "Odkaz"],
  },
  en: {
    title: "A quote for Studio Lípa",
    description: "A website and a year of care",
    body: "Valid until 30 November. The customer has not opened it yet.",
    open: "Open",
    send: "Remind",
    sent: "Sent",
    muted: "Tip",
    mutedText: "You change the quote template in Settings.",
    link: "Price list",
    linkText: "The prices quotes are made of.",
    states: ["With content and actions", "Muted", "Link"],
  },
}[locale];
const code = {
  astro: `
---
import Card from "@design-system/astro/Card.astro";
import Button from "@design-system/astro/Button.astro";
---
<Card title="${t.title}" description="${t.description}">
  <p>${t.body}</p>
  <Fragment slot="footer">
    <Button size="sm">${t.open}</Button>
  </Fragment>
</Card>
<Card href="/pricebook/" title="${t.link}" description="${t.linkText}" />`,
  react: `
import { Button, Card } from "@design-system/react";

<Card title="${t.title}" description="${t.description}" footer={<Button size="sm">${t.open}</Button>}>
  <p>${t.body}</p>
</Card>
<Card href="/pricebook/" title="${t.link}" description="${t.linkText}" />`,
};
---
<Layout {...props} code={code}>
  <Demo slot="example" locale={locale}>
    {
      () => (
        <Card title={t.title} description={t.description}>
          <p class="ds-type-body-sm" style="margin:0">{t.body}</p>
          <Fragment slot="footer">
            <Badge tone="info">{t.sent}</Badge>
          </Fragment>
        </Card>
      )
    }
  </Demo>
  <States slot="states" items={t.states} wide>
    {
      (index: number) =>
        [
          <Card title={t.title} description={t.description}>
            <p class="ds-type-body-sm" style="margin:0">{t.body}</p>
            <Fragment slot="footer">
              <Button size="sm" variant="primary">{t.open}</Button>
              <Button size="sm">{t.send}</Button>
            </Fragment>
          </Card>,
          <Card tone="muted" title={t.muted} description={t.mutedText} />,
          <Card href="#section-states" title={t.link} description={t.linkText} />,
        ][index]
    }
  </States>
</Layout>
