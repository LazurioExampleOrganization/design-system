---
// The frame of a component page: header, example in both themes, states,
// the Markdown (use, content, accessibility), do and don't, and the code.
import Code from "../../components/Code.astro";
import DoDont from "../../components/DoDont.astro";
import Markdown from "../../components/Markdown.astro";
import PageHeader from "../../components/PageHeader.astro";
import Section from "../../components/Section.astro";
import { word } from "../../lib/site";
import type { ViewProps } from "../types";

interface Props extends ViewProps {
  code: { astro: string; react: string };
}

const { locale, slug, entry, code } = Astro.props;
const id = slug.replace(/\W+/g, "-");
---
<article class="page">
  <PageHeader title={entry.data.title} description={entry.data.description} />
  <Section title={word("example", locale)} id="example">
    <slot name="example" />
  </Section>
  {
    Astro.slots.has("states") && (
      <Section title={word("states", locale)} id="states">
        <slot name="states" />
      </Section>
    )
  }
  <Markdown entry={entry} />
  <DoDont locale={locale} items={entry.data} />
  <Section title={word("code", locale)} id="code">
    <Code id={`${id}-code`} locale={locale} astro={code.astro} react={code.react} />
  </Section>
  <slot />
</article>
