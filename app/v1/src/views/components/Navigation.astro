---
import Breadcrumbs from "@design-system/astro/Breadcrumbs.astro";
import Nav from "@design-system/astro/Nav.astro";
import Demo from "../../components/Demo.astro";
import States from "../../components/States.astro";
import type { ViewProps } from "../types";
import Layout from "./Layout.astro";

type Props = ViewProps;
const props = Astro.props;
const { locale } = props;
const t = {
  cs: {
    label: "Hlavní navigace",
    items: ["Přehled", "Faktury", "Nabídky", "Zákazníci", "Nastavení"],
    crumbs: ["Example", "Faktury", "2026-0142"],
    states: ["Svislá se skupinou", "Vodorovná", "Drobečková navigace"],
    group: "Prodej",
  },
  en: {
    label: "Main navigation",
    items: ["Overview", "Invoices", "Quotes", "Customers", "Settings"],
    crumbs: ["Example", "Invoices", "2026-0142"],
    states: ["Vertical with a group", "Horizontal", "Breadcrumbs"],
    group: "Sales",
  },
}[locale];
const icons = ["home-simple", "page", "mail", "group", "settings"] as const;
const items = t.items.map((label, index) => ({
  href: `#section-example`,
  label,
  icon: icons[index],
  current: index === 1,
  badge: index === 1 ? "3" : undefined,
}));
const crumbs = t.crumbs.map((label, index) => ({ label, href: index < 2 ? "#section-states" : undefined }));
const code = {
  astro: `
---
import Nav from "@design-system/astro/Nav.astro";
import Breadcrumbs from "@design-system/astro/Breadcrumbs.astro";
---
<Nav label="${t.label}" items={[
  { href: "/", label: "${t.items[0]}", icon: "home-simple" },
  { href: "/invoices/", label: "${t.items[1]}", icon: "page", current: true, badge: "3" },
]} />
<Breadcrumbs items={[{ label: "${t.crumbs[1]}", href: "/invoices/" }, { label: "${t.crumbs[2]}" }]} />`,
  react: `
import { Breadcrumbs, Nav } from "@design-system/react";

<Nav label="${t.label}" items={[
  { href: "/", label: "${t.items[0]}", icon: "home-simple" },
  { href: "/invoices/", label: "${t.items[1]}", icon: "page", current: true, badge: "3" },
]} />
<Breadcrumbs items={[{ label: "${t.crumbs[1]}", href: "/invoices/" }, { label: "${t.crumbs[2]}" }]} />`,
};
---
<Layout {...props} code={code}>
  <Demo slot="example" locale={locale} layout="stack">
    {(theme: string) => <Nav id={`nav-example-${theme}`} label={t.label} items={items} />}
  </Demo>
  <States slot="states" items={t.states} wide>
    {
      (index: number) =>
        [
          <Nav id="nav-group" title={t.group} items={items.slice(1, 4).map((item) => ({ ...item, icon: undefined }))} />,
          <Nav id="nav-horizontal" label={t.label} orientation="horizontal" items={items.slice(0, 4).map((item) => ({ ...item, icon: undefined, badge: undefined }))} />,
          <Breadcrumbs items={crumbs} locale={locale} />,
        ][index]
    }
  </States>
</Layout>
