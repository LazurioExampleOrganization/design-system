---
import Icon from "@design-system/astro/Icon.astro";
import { ICON_NAMES } from "@design-system/core/icons";
import Demo from "../../components/Demo.astro";
import DoDont from "../../components/DoDont.astro";
import Markdown from "../../components/Markdown.astro";
import PageHeader from "../../components/PageHeader.astro";
import Section from "../../components/Section.astro";
import type { ViewProps } from "../types";

type Props = ViewProps;
const { locale, entry } = Astro.props;
const t = {
  cs: { set: "Sada", sizes: "Velikosti", count: `${ICON_NAMES.length} ikon z Iconoiru` },
  en: { set: "The set", sizes: "Sizes", count: `${ICON_NAMES.length} icons from Iconoir` },
}[locale];
---
<article class="page">
  <PageHeader title={entry.data.title} description={entry.data.description} />
  <Markdown entry={entry} />
  <Section title={t.sizes} id="sizes">
    <Demo locale={locale}>
      {
        () => (
          <>
            <Icon name="calendar" size="sm" />
            <Icon name="calendar" />
            <Icon name="calendar" size="lg" />
            <span class="ds-type-meta">sm · md · lg</span>
          </>
        )
      }
    </Demo>
  </Section>
  <Section title={t.set} id="set">
    <p class="ds-type-meta">{t.count}</p>
    <div class="icon-grid">
      {
        ICON_NAMES.map((name) => (
          <figure>
            <Icon name={name} size="lg" />
            <figcaption><code>{name}</code></figcaption>
          </figure>
        ))
      }
    </div>
  </Section>
  <DoDont locale={locale} items={entry.data} />
</article>
