---
import EmptyState from "@design-system/astro/EmptyState.astro";
import { illustrations } from "@design-system/brand";
import Demo from "../../components/Demo.astro";
import DoDont from "../../components/DoDont.astro";
import Markdown from "../../components/Markdown.astro";
import PageHeader from "../../components/PageHeader.astro";
import Section from "../../components/Section.astro";
import type { ViewProps } from "../types";

type Props = ViewProps;
const { locale, entry } = Astro.props;
const t = {
  cs: { set: "Ilustrace značky", names: { empty: "Prázdný začátek", search: "Nic nenalezeno", done: "Hotovo" } as Record<string, string> },
  en: { set: "The brand's illustrations", names: { empty: "An empty start", search: "Nothing found", done: "Done" } as Record<string, string> },
}[locale];
const names = Object.keys(illustrations) as (keyof typeof illustrations)[];
---
<article class="page">
  <PageHeader title={entry.data.title} description={entry.data.description} />
  <Markdown entry={entry} />
  <Section title={t.set} id="set">
    <Demo locale={locale}>
      {
        () => (
          <div class="grid" style="width:100%">
            {names.map((name) => (
              <EmptyState title={t.names[name] ?? name} illustration={name} headingLevel={3} />
            ))}
          </div>
        )
      }
    </Demo>
  </Section>
  <DoDont locale={locale} items={entry.data} />
</article>
