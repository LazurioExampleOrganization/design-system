---
import Badge from "@design-system/astro/Badge.astro";
import Table from "@design-system/astro/Table.astro";
import { contrast, MINIMUM } from "@design-system/core/contrast";
import { color, colorSource, colorUse, contrastPairs, palette } from "@design-system/tokens";
import DoDont from "../../components/DoDont.astro";
import Markdown from "../../components/Markdown.astro";
import PageHeader from "../../components/PageHeader.astro";
import Section from "../../components/Section.astro";
import type { ViewProps } from "../types";

type Props = ViewProps;
const { locale, entry } = Astro.props;
const t = {
  cs: {
    palette: "Paleta",
    roles: "Role barev",
    contrast: "Kontrast",
    role: "Role",
    light: "Světlý",
    dark: "Tmavý",
    use: "Použití",
    pair: "Dvojice",
    kind: "Druh",
    text: "text",
    graphic: "grafika",
    pass: "Projde",
    fail: "Neprojde",
    rolesCaption: "Role barev ve světlém a tmavém režimu",
    contrastCaption: "Kontrast dvojic rolí podle WCAG 2.2",
  },
  en: {
    palette: "Palette",
    roles: "Colour roles",
    contrast: "Contrast",
    role: "Role",
    light: "Light",
    dark: "Dark",
    use: "Use",
    pair: "Pair",
    kind: "Kind",
    text: "text",
    graphic: "graphic",
    pass: "Passes",
    fail: "Fails",
    rolesCaption: "Colour roles in the light and dark themes",
    contrastCaption: "Contrast of the role pairs by WCAG 2.2",
  },
}[locale];
const onStep = (hex: string) => (contrast(hex, "#ffffff") >= contrast(hex, "#000000") ? "#ffffff" : "#000000");
const roles = Object.keys(color.light) as (keyof typeof color.light)[];
const pairs = [
  ...contrastPairs.text.map(([fg, bg]) => ({ fg, bg, kind: "text" as const })),
  ...contrastPairs.graphic.map(([fg, bg]) => ({ fg, bg, kind: "graphic" as const })),
].map((pair) => ({
  ...pair,
  light: contrast(color.light[pair.fg], color.light[pair.bg]),
  dark: contrast(color.dark[pair.fg], color.dark[pair.bg]),
}));
const ratio = (value: number) => value.toLocaleString(locale === "cs" ? "cs-CZ" : "en-GB", { maximumFractionDigits: 2, minimumFractionDigits: 2 });
---
<article class="page">
  <PageHeader title={entry.data.title} description={entry.data.description} />
  <Markdown entry={entry} />
  <Section title={t.palette} id="palette">
    {
      Object.entries(palette).map(([name, steps]) => (
        <div style="display:grid;gap:var(--ds-space-8)">
          <p class="ramp__name">{name}</p>
          <div class="ramp">
            {Object.entries(steps).map(([step, hex]) => (
              <div class="ramp__step" style={`background:${hex};color:${onStep(hex)}`}>
                <span>{step}</span>
                <code>{hex.slice(1)}</code>
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </Section>
  <Section title={t.roles} id="roles">
    <Table id="roles-table" caption={t.rolesCaption} hideCaption density="compact">
      <thead>
        <tr><th scope="col">{t.role}</th><th scope="col">{t.light}</th><th scope="col">{t.dark}</th><th scope="col">{t.use}</th></tr>
      </thead>
      <tbody>
        {
          roles.map((role) => (
            <tr>
              <th scope="row" class="ds-table__nowrap"><code>{role}</code></th>
              <td class="ds-table__nowrap"><span class="chip" style={`background:${color.light[role]}`} /> <code>{colorSource.light[role]}</code></td>
              <td class="ds-table__nowrap"><span class="chip" style={`background:${color.dark[role]}`} /> <code>{colorSource.dark[role]}</code></td>
              <td>{colorUse[role][locale]}</td>
            </tr>
          ))
        }
      </tbody>
    </Table>
  </Section>
  <Section title={t.contrast} id="contrast">
    <Table id="contrast-table" caption={t.contrastCaption} hideCaption density="compact">
      <thead>
        <tr><th scope="col">{t.pair}</th><th scope="col">{t.kind}</th><th scope="col" class="ds-table__num">{t.light}</th><th scope="col" class="ds-table__num">{t.dark}</th></tr>
      </thead>
      <tbody>
        {
          pairs.map((pair) => (
            <tr>
              <th scope="row"><code>{pair.fg}</code> / <code>{pair.bg}</code></th>
              <td>{t[pair.kind]}</td>
              {[pair.light, pair.dark].map((value) => (
                <td class="ds-table__num">
                  {ratio(value)} : 1{" "}
                  <Badge tone={value >= MINIMUM[pair.kind] ? "success" : "danger"}>{value >= MINIMUM[pair.kind] ? t.pass : t.fail}</Badge>
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </Table>
  </Section>
  <DoDont locale={locale} items={entry.data} />
</article>
