---
import Table from "@design-system/astro/Table.astro";
import { radius, size, space } from "@design-system/tokens";
import DoDont from "../../components/DoDont.astro";
import Markdown from "../../components/Markdown.astro";
import PageHeader from "../../components/PageHeader.astro";
import Section from "../../components/Section.astro";
import type { ViewProps } from "../types";

type Props = ViewProps;
const { locale, entry } = Astro.props;
const t = {
  cs: {
    space: "Rozestupy",
    radius: "Zaoblení",
    elevation: "Hloubka",
    sizes: "Velikosti",
    token: "Token",
    value: "Hodnota",
    spaceCaption: "Škála rozestupů",
    sizeCaption: "Velikosti prvků",
    flow: "Objekt v toku stránky: vlasová linka, bez stínu",
    float: "Plovoucí vrstva: vlasová linka a jediný stín",
    radiusUse: {
      xs: "štítek dat",
      sm: "ikonové tlačítko, položka navigace",
      md: "karta, dialog, upozornění, víceřádkové pole",
      lg: "velká ukázková plocha",
      pill: "tlačítko, pole, odznak, přepínač",
    } as Record<string, string>,
  },
  en: {
    space: "Space",
    radius: "Radius",
    elevation: "Depth",
    sizes: "Sizes",
    token: "Token",
    value: "Value",
    spaceCaption: "The space scale",
    sizeCaption: "Sizes of elements",
    flow: "An object in the page flow: a hairline, no shadow",
    float: "The floating layer: a hairline and the one shadow",
    radiusUse: {
      xs: "data tag",
      sm: "icon button, navigation item",
      md: "card, dialog, alert, multi-line field",
      lg: "a large showcase surface",
      pill: "button, field, badge, switch",
    } as Record<string, string>,
  },
}[locale];
---
<article class="page">
  <PageHeader title={entry.data.title} description={entry.data.description} />
  <Markdown entry={entry} />
  <Section title={t.space} id="space">
    <Table id="space-table" caption={t.spaceCaption} hideCaption density="compact">
      <thead><tr><th scope="col">{t.token}</th><th scope="col" class="ds-table__num">{t.value}</th><th scope="col"><span class="ds-visually-hidden">{t.space}</span></th></tr></thead>
      <tbody>
        {
          Object.entries(space).map(([key, value]) => (
            <tr>
              <th scope="row"><code>space-{key}</code></th>
              <td class="ds-table__num">{value}</td>
              <td><span style={`display:block;height:var(--ds-space-8);width:var(--ds-space-${key});background:var(--ds-color-accent);border-radius:var(--ds-radius-xs)`} /></td>
            </tr>
          ))
        }
      </tbody>
    </Table>
  </Section>
  <Section title={t.radius} id="radius">
    <div class="grid grid--small">
      {
        Object.entries(radius).map(([key, value]) => (
          <figure class="swatch">
            <div class="swatch__chip" style={`height:var(--ds-space-64);border-radius:var(--ds-radius-${key});background:var(--ds-color-surface)`} />
            <figcaption>
              <code>radius-{key} · {value}</code>
              <span>{t.radiusUse[key]}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </Section>
  <Section title={t.elevation} id="elevation">
    <div class="stage">
      <div class="stage__panel">
        <div class="grid">
          <div class="ds-card"><p class="ds-type-body-sm" style="margin:0">{t.flow}</p></div>
          <div class="ds-card" style="background:var(--ds-color-surface-raised);box-shadow:var(--ds-shadow-float)"><p class="ds-type-body-sm" style="margin:0">{t.float}</p></div>
        </div>
      </div>
    </div>
  </Section>
  <Section title={t.sizes} id="sizes">
    <Table id="size-table" caption={t.sizeCaption} hideCaption density="compact">
      <thead><tr><th scope="col">{t.token}</th><th scope="col" class="ds-table__num">{t.value}</th></tr></thead>
      <tbody>
        {
          Object.entries(size).map(([key, value]) => (
            <tr>
              <th scope="row"><code>size-{key}</code></th>
              <td class="ds-table__num">{value}</td>
            </tr>
          ))
        }
      </tbody>
    </Table>
  </Section>
  <DoDont locale={locale} items={entry.data} />
</article>
