---
import Button from "@design-system/astro/Button.astro";
import Table from "@design-system/astro/Table.astro";
import { motion } from "@design-system/tokens";
import DoDont from "../../components/DoDont.astro";
import Markdown from "../../components/Markdown.astro";
import PageHeader from "../../components/PageHeader.astro";
import Section from "../../components/Section.astro";
import type { ViewProps } from "../types";

type Props = ViewProps;
const { locale, entry } = Astro.props;
const t = {
  cs: {
    durations: "Délky",
    easings: "Křivky",
    play: "Přehrát",
    token: "Token",
    value: "Hodnota",
    use: "Kdy",
    durationCaption: "Délky pohybu",
    easeCaption: "Křivky pohybu",
    durationUse: {
      press: "Stisk tlačítka, zaškrtnutí",
      fast: "Barva při najetí, nápověda",
      base: "Nabídka, přepínač, oznámení",
      slow: "Dialog, boční panel",
      exit: "Odchod: kratší než příchod",
    } as Record<string, string>,
    easeUse: {
      out: "Vstup a odchod: rychlý začátek, měkký dojezd",
      "in-out": "Pohyb po obrazovce",
      standard: "Změna barvy",
      linear: "Stálý pohyb: průběh, točící se kolečko",
    } as Record<string, string>,
  },
  en: {
    durations: "Durations",
    easings: "Easing",
    play: "Play",
    token: "Token",
    value: "Value",
    use: "When",
    durationCaption: "Durations of motion",
    easeCaption: "Easing curves",
    durationUse: {
      press: "A press, a check",
      fast: "Colour on hover, a tooltip",
      base: "A menu, a switch, a toast",
      slow: "A dialog, a side panel",
      exit: "Leaving: shorter than entering",
    } as Record<string, string>,
    easeUse: {
      out: "Entering and leaving: a quick start, a soft landing",
      "in-out": "Moving across the screen",
      standard: "A change of colour",
      linear: "Steady motion: progress, a spinner",
    } as Record<string, string>,
  },
}[locale];
---
<article class="page">
  <PageHeader title={entry.data.title} description={entry.data.description} />
  <Markdown entry={entry} />
  <Section title={t.durations} id="durations">
    <Table id="duration-table" caption={t.durationCaption} hideCaption density="compact">
      <thead><tr><th scope="col">{t.token}</th><th scope="col" class="ds-table__num">{t.value}</th><th scope="col">{t.use}</th></tr></thead>
      <tbody>
        {Object.entries(motion.duration).map(([key, value]) => (
          <tr><th scope="row"><code>duration-{key}</code></th><td class="ds-table__num">{value}</td><td>{t.durationUse[key]}</td></tr>
        ))}
      </tbody>
    </Table>
  </Section>
  <Section title={t.easings} id="easings">
    <Table id="ease-table" caption={t.easeCaption} hideCaption density="compact">
      <thead><tr><th scope="col">{t.token}</th><th scope="col">{t.value}</th><th scope="col">{t.use}</th></tr></thead>
      <tbody>
        {Object.entries(motion.ease).map(([key, value]) => (
          <tr><th scope="row"><code>ease-{key}</code></th><td><code>{value}</code></td><td>{t.easeUse[key]}</td></tr>
        ))}
      </tbody>
    </Table>
    <div class="stage">
      <div class="stage__panel">
        {
          (["out", "in-out"] as const).map((ease) => (
            <div class="motion-demo" data-motion-demo style={`--_ease:var(--ds-ease-${ease});--_duration:var(--ds-duration-slow)`}>
              <span class="motion-demo__dot" />
            </div>
          ))
        }
        <div class="stage__row">
          <Button icon="arrow-right" data-motion-play>{t.play}</Button>
        </div>
      </div>
    </div>
  </Section>
  <DoDont locale={locale} items={entry.data} />
</article>
<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-motion-play]")) {
    button.addEventListener("click", () => {
      for (const demo of document.querySelectorAll<HTMLElement>("[data-motion-demo]")) {
        const dot = demo.querySelector<HTMLElement>(".motion-demo__dot");
        const distance = dot ? demo.clientWidth - dot.offsetWidth - dot.offsetLeft * 2 : 0;
        demo.style.setProperty("--_distance", `${demo.hasAttribute("data-playing") ? 0 : distance}px`);
        demo.toggleAttribute("data-playing");
      }
    });
  }
</script>
