---
import Icon from "./Icon.astro";
import type { IconName } from "./types";

// content/components/button.md
interface Props {
  variant?: "primary" | "secondary" | "ghost" | "danger";
  size?: "default" | "compact";
  icon?: IconName;
  disabled?: boolean;
  loading?: boolean;
  type?: "button" | "submit";
  class?: string;
  // Opens the modal Dialog with this id.
  opens?: string;
  // Closes the modal Dialog it is in.
  closes?: boolean;
  autofocus?: boolean;
}

const {
  variant = "secondary",
  size = "default",
  icon,
  disabled = false,
  loading = false,
  type = "button",
  class: extra,
  opens,
  closes = false,
  autofocus = false,
} = Astro.props;
---

<button
  type={type}
  class:list={["btn", `btn-${variant}`, size === "compact" && "btn-compact", extra]}
  disabled={disabled || loading}
  aria-busy={loading ? "true" : undefined}
  aria-haspopup={opens ? "dialog" : undefined}
  data-dialog-open={opens}
  data-dialog-close={closes ? "" : undefined}
  autofocus={autofocus}
>
  {loading ? <span class="spinner" aria-hidden="true" /> : icon && <Icon name={icon} size={20} />}
  <slot />
</button>
