---
import { tokens } from "../../tokens";

// The one place where live toasts appear (content/components/toast.md): a
// polite live region, bottom right. At most three toasts; the oldest leaves
// first.
---

<div class="toast-region" aria-live="polite" data-toast-region data-dismiss={tokens.motion["toast-dismiss"]}></div>

<script>
  import { dismissTimer } from "../../lib/dismiss-timer";

  const region = document.querySelector<HTMLElement>("[data-toast-region]");
  const dismissAfter = Number(region?.dataset.dismiss ?? 0);

  function show(templateId: string) {
    const template = document.getElementById(templateId);
    if (!region || !(template instanceof HTMLTemplateElement)) return;
    const toast = template.content.firstElementChild?.cloneNode(true);
    if (!(toast instanceof HTMLElement)) return;
    let stop = () => {};
    const close = () => {
      stop();
      toast.remove();
    };
    toast.querySelector("[data-toast-close]")?.addEventListener("click", close);
    if (toast.dataset.variant === "info" || toast.dataset.variant === "success") {
      // Leaves after the dismiss time, but never while the reader hovers it or
      // has focus inside it (lib/dismiss-timer.ts).
      const timer = dismissTimer(dismissAfter, close, {
        set: (run, ms) => window.setTimeout(run, ms),
        clear: (id) => window.clearTimeout(id),
      });
      stop = timer.stop;
      toast.addEventListener("mouseenter", () => timer.hover(true));
      toast.addEventListener("mouseleave", () => timer.hover(false));
      toast.addEventListener("focusin", () => timer.focus(true));
      toast.addEventListener("focusout", (event) =>
        timer.focus(event.relatedTarget instanceof Node && toast.contains(event.relatedTarget)),
      );
    }
    region.append(toast);
    while (region.children.length > 3) region.firstElementChild?.remove();
  }

  for (const trigger of document.querySelectorAll<HTMLElement>("[data-toast]")) {
    trigger.addEventListener("click", () => show(trigger.dataset.toast ?? ""));
  }
</script>
