---
import "../styles/global.css";
import { tokens } from "../tokens";

const sections = [
  {
    title: "Brand",
    description: "Colours, typography, logo rules and the baseline identity.",
    path: "content/brand/",
  },
  {
    title: "Examples",
    description: "Reviewable references for web, slides, documents and tables.",
    path: "content/examples/",
  },
  {
    title: "Templates",
    description: "Reusable starters for repeated output formats.",
    path: "content/templates/",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{tokens.name} design system</title>
  </head>
  <body>
    <main class="shell">
      <header class="hero">
        <p class="eyebrow">Design system</p>
        <h1>{tokens.name} design baseline</h1>
        <p>
          Read-only viewer for the <code>content/</code> directory of this repository. Authoring
          happens in Git by editing files, not inside this App.
        </p>
      </header>

      <section class="grid" aria-label="Design system sections">
        {sections.map((section) => (
          <article class="card">
            <h2>{section.title}</h2>
            <p>{section.description}</p>
            <code>{section.path}</code>
          </article>
        ))}
      </section>

      <section class="panel">
        <h2>Colour tokens <small>({tokens.status})</small></h2>
        <div class="swatches">
          {Object.entries(tokens.colors).map(([name, value]) => (
            <div class="swatch">
              <span class="chip" style={`background:${value}`}></span>
              <div>
                <strong>{name}</strong>
                <code>{value}</code>
              </div>
            </div>
          ))}
        </div>
      </section>
    </main>
  </body>
</html>
