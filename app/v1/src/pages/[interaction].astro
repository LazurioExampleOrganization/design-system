---
// A page built only for the interaction test (DS_TEST_PAGES=1): busy and idle
// buttons of the Astro kit in forms, with counters the test reads.
import Button from "../../kit/astro/Button.astro";

export function getStaticPaths() {
  return process.env.DS_TEST_PAGES === "1" ? [{ params: { interaction: "interaction" } }] : [];
}
---
<!doctype html>
<html lang="en">
  <head><meta charset="utf-8" /><title>Interaction</title></head>
  <body>
    <form id="busy-form"><input id="busy-input" name="x" /><Button id="busy" type="submit" variant="primary" busy>Saving</Button></form>
    <form id="idle-form"><input id="idle-input" name="x" /><Button id="idle" type="submit">Save</Button></form>
    <Button id="busy-action" busy>Running</Button>
    <Button id="busy-link" href="/elsewhere/" busy>Opening</Button>
    <script is:inline>
      window.counts = { busy: 0, idle: 0, "busy-action": 0, submitBusy: 0, submitIdle: 0 };
      for (const id of ["busy", "idle", "busy-action"]) {
        document.getElementById(id).addEventListener("click", () => window.counts[id]++);
      }
      document.getElementById("busy-form").addEventListener("submit", (event) => {
        event.preventDefault();
        window.counts.submitBusy++;
      });
      document.getElementById("idle-form").addEventListener("submit", (event) => {
        event.preventDefault();
        window.counts.submitIdle++;
      });
    </script>
  </body>
</html>
