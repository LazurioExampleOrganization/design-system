---
import GallerySet from "../../components/GallerySet.astro";
import Viewer from "../../layouts/Viewer.astro";
---

<Viewer title="Gallery" description="Every component in its states, in the light and the dark theme." wide>
  <p class="eyebrow">Components</p>
  <h1>Gallery</h1>
  <p class="lead">
    The reference implementation of every component in its states, in both themes. Each heading
    leads to the component's rules.
  </p>
  <section class="theme-panel" data-theme="light">
    <h2>Light</h2>
    <GallerySet prefix="light" />
  </section>
  <section class="theme-panel" data-theme="dark">
    <h2>Dark</h2>
    <GallerySet prefix="dark" />
  </section>
</Viewer>
